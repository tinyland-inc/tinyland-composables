{
  "name": "@tummycrypt/tinyland-composables",
  "version": "0.2.2",
  "description": "Svelte 5 rune-based composables for reactive state management, lifecycle utilities, theming, and Web Worker synchronization",
  "type": "module",
  "license": "Zlib AND LicenseRef-Tinyland-Proprietary",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "dev": "svelte-package -i src -o dist --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig tsconfig.json",
    "prepublishOnly": "pnpm build && pnpm check:package",
    "check:package": "publint"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "runes",
    "composables",
    "reactive",
    "lifecycle",
    "theming",
    "web-worker"
  ],
  "author": "Tinyland.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinyland-inc/tinyland-composables.git"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0",
    "runed": ">=0.20.0"
  },
  "peerDependenciesMeta": {
    "runed": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/package": "^2.0.0",
    "@types/node": "^22.0.0",
    "happy-dom": "^17.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0",
    "publint": "^0.3.18"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "packageManager": "pnpm@10.13.1",
  "homepage": "https://github.com/tinyland-inc/tinyland-composables",
  "bugs": {
    "url": "https://github.com/tinyland-inc/tinyland-composables/issues"
  }
}